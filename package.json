{
  "name": "@pulkitxm/hugsy",
  "version": "0.3.0",
  "private": true,
  "description": "Source-owned iOS components and services, CLI and MCP server",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pulkitxm/hugsy.git"
  },
  "homepage": "https://hugsy.pulkit.page/",
  "engines": {
    "node": ">=22.16"
  },
  "packageManager": "bun@1.4.2",
  "overrides": {
    "basic-ftp": "6.2.1",
    "re2js": "2.8.7"
  },
  "scripts": {
    "dev": "bun run generate && vite --port 3000",
    "generate": "bun scripts/generate.ts",
    "build:cli": "swift build --product hugsy -Xswiftc -warnings-as-errors",
    "build": "bun run generate && vite build && bun scripts/check-site.ts && bun scripts/compress.ts",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "lint": "biome check --error-on-warnings .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:native": "playwright test --config playwright.native.config.ts",
    "test:protocol": "vitest run --config vitest.protocol.config.ts",
    "check:repository": "bun scripts/check-repository.ts",
    "check:dead-code": "knip --max-issues 0 --treat-config-hints-as-errors",
    "check:markdown": "markdownlint-cli2 '**/*.md' '!node_modules' '!dist'",
    "check:html": "html-validate 'dist/client/**/*.html'",
    "check:yaml": "bun scripts/check-yaml.ts",
    "check:swift": "xcrun swift-format lint --strict --recursive Package.swift registry/swift examples tools tests && swift build -Xswiftc -warnings-as-errors -Xswiftc -strict-concurrency=complete && swift test",
    "check:lighthouse": "lhci autorun",
    "ci": "bun run build && bun run lint && bun run typecheck && bun run check:repository && bun run check:dead-code && bun run check:markdown && bun run check:html && bun run check:yaml && bun run test:coverage",
    "prepare": "bun run generate && bun scripts/install-hooks.ts"
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.4",
    "lucide-react": "1.68.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@babel/parser": "8.1.0",
    "@biomejs/biome": "2.6.5",
    "@lhci/cli": "0.16.0",
    "@modelcontextprotocol/client": "2.4.0",
    "@playwright/test": "1.64.1",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "html-validate": "11.18.0",
    "knip": "6.44.1",
    "markdownlint-cli2": "0.24.0",
    "parse5": "8.1.0",
    "sharp": "0.35.5",
    "shiki": "4.6.0",
    "sirv": "3.0.2",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  }
}
