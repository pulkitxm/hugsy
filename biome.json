{
  "$schema": "https://biomejs.dev/schemas/2.6.5/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!!**/node_modules",
      "!!**/dist",
      "!!**/generated",
      "!!**/.build",
      "!!src/routeTree.gen.ts",
      "!bun.lock"
    ]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "linter": {
    "rules": {
      "preset": "recommended",
      "a11y": { "preset": "all" },
      "security": {
        "preset": "all",
        "noSecrets": { "level": "error", "options": { "entropyThreshold": 60 } }
      },
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "noUnusedFunctionParameters": "error"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noFocusedTests": "error",
        "noSkippedTests": "error",
        "noConsole": "error",
        "noArrayIndexKey": "error",
        "noTsIgnore": "error"
      },
      "style": {
        "noNonNullAssertion": "error",
        "noParameterAssign": "error",
        "noNestedTernary": "error",
        "useImportType": "error",
        "useBlockStatements": "error",
        "useNodejsImportProtocol": "error",
        "useThrowOnlyError": "error"
      },
      "performance": { "noBarrelFile": "error", "noReExportAll": "error" },
      "nursery": {
        "noFloatingPromises": "error",
        "noMisusedPromises": "error",
        "noUnsafeReturn": "error",
        "noUnsafeTypeAssertion": "error"
      }
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "overrides": [
    {
      "includes": ["**/*.ts", "**/*.tsx"],
      "linter": { "rules": { "complexity": { "useLiteralKeys": "off" } } }
    },
    {
      "includes": ["src/styles.css", "src/theme.css"],
      "linter": { "rules": { "style": { "noDescendingSpecificity": "off" } } }
    }
  ]
}
