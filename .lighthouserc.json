{
  "ci": {
    "collect": {
      "startServerCommand": "HUGSY_PORT=4174 bun scripts/serve.ts",
      "url": [
        "http://127.0.0.1:4174/hugsy/",
        "http://127.0.0.1:4174/hugsy/components/expanding-cards/",
        "http://127.0.0.1:4174/hugsy/docs/"
      ],
      "numberOfRuns": 3,
      "settings": { "chromeFlags": "--headless --no-sandbox" }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.95, "aggregationMethod": "median" }],
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 1 }],
        "categories:seo": ["error", { "minScore": 1 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci/reports" }
  }
}
